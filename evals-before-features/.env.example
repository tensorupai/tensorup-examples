# Copy to .env (gitignored) or export in your shell. Fill in the key for the provider you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: openai (default) or anthropic
TENSORUP_PROVIDER=
# Optional: override DEFAULT_OPENAI_MODEL (gpt-6-luna) or DEFAULT_ANTHROPIC_MODEL (claude-haiku-5-5)
TENSORUP_MODEL=
# Optional: override the judge, DEFAULT_OPENAI_JUDGE (gpt-6.1-terra) or DEFAULT_ANTHROPIC_JUDGE (claude-sonnet-5-5)
TENSORUP_JUDGE_MODEL=
# Required for any live call
TENSORUP_LIVE=
